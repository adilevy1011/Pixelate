window {
    title: "PXL Control Flow Demo"
    width: 800
    height: 600
    background: 235 240 250
}

script {
    int count = 0
    int limit = 3
    double scale = 1.5
    bool enabled = true
    String message = "Control flow is working!"

    add label heading {
        text: "Variables, loops, conditions, and mouse support"
        x: 40
        y: 40
        width: 600
        height: 35
    }

    add label status {
        text: "Starting..."
        x: 40
        y: 100
        width: 600
        height: 35
    }

    add label loopStatus {
        text: "The for loop has not run yet."
        x: 40
        y: 150
        width: 600
        height: 35
    }

    add label mouseStatus {
        text: "Move the mouse around the window."
        x: 40
        y: 200
        width: 600
        height: 35
    }

    add label mouseX {
        text: "Mouse X: 0"
        x: 40
        y: 240
        width: 180
        height: 35
    }

    add label mouseY {
        text: "Mouse Y: 0"
        x: 240
        y: 240
        width: 180
        height: 35
    }

    trigger(mouseMove) {
        mouseX.text = f"Mouse X: {mouse.x}"
        mouseY.text = f"Mouse Y: {mouse.y}"
    }

    add button resetCursor {
        text: "Reset cursor to arrow"
        x: 40
        y: 310
        width: 220
        height: 45
        onclick {
            update mouse.shape = ARROW
            update mouseStatus.text = "Cursor reset to ARROW."
        }
    }

    update heading {
        text: "Variables, loops, conditions, triggers, and mouse support"
        x: 30
        width: 700
    }

    if (enabled == true) {
        update status.text = "The bool variable enabled is true."
    }

    while (count < 2) {
        count++
    }

    if (count == 2) {
        update status.text = "The while loop finished at count 2."
    }

    for (int i = 0; i < limit; i++) {
        update loopStatus.text = "The for loop is running..."
    }

    update loopStatus.text = "The for loop finished after 3 iterations."

    if (mouse.x >= 0) {
        update mouse.shape = HAND
        update mouseStatus.text = "Mouse x position is available through mouse.x."
    }

    if (mouse.y >= 0) {
        update mouseStatus.text = "Mouse x and y positions are available through mouse.x and mouse.y."
    }

    trigger(count == 2) {
        update status.text = "A condition trigger detected count == 2."
    }
}
