window {
    title: "PXL Variables",
    width: 700,
    height: 420,
    background: 245 247 252,
}

script {
    int score = 42;
    double progress = 0.75;
    bool enabled = true;
    char grade = 'A';
    String player = "Pixel Player";

    add label heading {
        text: "Variables",
        x: 40,
        y: 35,
        width: 620,
        height: 45,
    }

    add label values {
        text: f"Player: {player} | score: {score} | progress: {progress}",
        x: 40,
        y: 110,
        width: 620,
        height: 35,
    }

    add label moreValues {
        text: f"enabled: {enabled} | grade: {grade}",
        x: 40,
        y: 160,
        width: 620,
        height: 35,
    }
}
