window {
    title: "PXL TextBox",
    width: 700,
    height: 460,
    background: 245 247 252,
}

script {
    add label heading {
        text: "Textbox input",
        x: 40,
        y: 35,
        width: 620,
        height: 45,
    }

    add textbox nameInput {
        text: "",
        placeholder: "Type your name here",
        x: 40,
        y: 110,
        width: 360,
        height: 32,
    }

    add label result {
        text: "Your name will appear here.",
        x: 40,
        y: 175,
        width: 620,
        height: 35,
    }

    add button showButton {
        text: "Read textbox",
        x: 40,
        y: 240,
        width: 220,
        height: 55,
        onclick {
            result.text = f"You entered: {nameInput.text}";
        }
    }
}
