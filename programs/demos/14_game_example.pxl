window {
    title: "Bab example",
    background: 100 100 255,
    width:1200,
    height: 800,

    label helloToBab {
        text: "Hi bab!",
        font: ARIAL,
        fontSize: 20,
        x: 30,
        y:30,
        width:200,
    }
}

script {
    add triangle player {
        p1: (300,320),
        p2: (290,300),
        p3: (280,320),
    }

    trigger(onkey("w")){
        player.y = player.y -5;
        helloToBab.text = "W is pressed";
        player.angle = 0;
    }
    trigger(onkey("s")){
        player.y = player.y +5;
        helloToBab.text = "S is pressed";
        player.angle = 180;
    }
    trigger(onkey("d")){
        player.x = player.x + 5;
        helloToBab.text = "D is pressed";
        player.angle = 90;
    }
    trigger(onkey("a")){
        player.x = player.x -5;
        helloToBab.text = "A is pressed";
        player.angle = 270;
    }
}