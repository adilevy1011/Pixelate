window {
    title: "PXL Demo"
    width: 800
    height: 600

    label greeting {
        text: "Hello from PXL"
        x: 50
        y: 50
        width: 300
        height: 40
    }

    button update {
        text: "Update label"
        x: 50
        y: 120
        width: 200
        height: 50

        on click {
            set_text greeting "Updated from a PXL action!"
        }
    }
}
